---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const proofPoints = [
  {
    title: "Private build state",
    body: "Every worktree keeps its own writable Cargo and rustc state. There is no shared mutable target directory."
  },
  {
    title: "Cheap inheritance",
    body: "APFS clones on macOS and reflinks on Linux let a warm checkout seed another without physically copying every block up front."
  },
  {
    title: "Cargo stays authoritative",
    body: "A seed is only a starting point. Cargo and rustc still decide what is fresh, stale, or incrementally reusable."
  },
  {
    title: "Built for hooks",
    body: "Use one CLI call from an IDE, agent runtime, shell script, or Git worktree hook. No Golden Goose-specific integration is required."
  }
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="section-label">Rust worktree cache seeding</p>
      <h1>New worktree. Near-warm first build.</h1>
      <p class="hero__lede">
        cargo-warm forks build state from a checkout that already paid the compile cost into a
        separate writable cache for the new worktree. You keep isolation without throwing away
        all of the useful work Cargo and rustc already did.
      </p>
      <div class="hero__actions">
        <a class="button button--solid" href="/docs/quickstart">Quickstart</a>
        <a class="button button--ghost" href="/docs/how-it-works">How it works</a>
      </div>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">Worktree init hook</p>
      <div class="hero__terminal">
        <span>$ git worktree add ../feature -b feature</span>
        <span>$ cd ../feature</span>
        <span>$ cargo warm seed</span>
        <span>$ cargo check</span>
      </div>
    </aside>
  </section>

  <section class="shell section-grid">
    <div class="section-heading">
      <p class="section-label">The model</p>
      <h2>Fork compiler state. Do not share its writable directory.</h2>
      <p>
        A warm main checkout is valuable state. cargo-warm makes that state cheap to inherit while
        keeping every agent, branch, and worktree independently writable.
      </p>
    </div>
    <div class="proof-grid">
      {proofPoints.map((item) => (
        <article class="proof-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell docs-teaser">
    <div class="section-heading">
      <p class="section-label">Documentation</p>
      <h2>Start with the hook, then inspect what Cargo actually reuses.</h2>
    </div>
    <div class="docs-teaser__grid">
      {docs.map((entry) => (
        <a class="docs-teaser__card" href={`/docs/${entry.id}`}>
          <span>{entry.data.category}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary ?? entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
